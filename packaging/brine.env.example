# Copy to /etc/brine/brine.env and chmod 0600.
#
# If no password is set, Brine generates one on first start and prints it to
# the log (it is also written to {data-dir}/credentials.json with mode 0600).
# Set these explicitly for unattended installs.

BRINE_AUTH_USER=admin
BRINE_AUTH_PASSWORD=CHANGE_ME

# Optional: bearer token for API clients. Generated and persisted if omitted.
# BRINE_API_TOKEN=CHANGE_ME
