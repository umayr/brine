{
  "private": true,
  "scripts": {
    "build:web": "npm run build:css && npm run build:js && npm run copy:vendor",
    "build:css": "tailwindcss -c tailwind.config.js -i ./internal/web/assets/app.css -o ./internal/web/static/vendor/app.css --minify",
    "build:js": "esbuild ./internal/web/assets/editor.js --bundle --format=esm --target=es2020 --outfile=./internal/web/static/vendor/editor.js --minify",
    "copy:vendor": "cp ./node_modules/htmx.org/dist/htmx.min.js ./internal/web/static/vendor/htmx.min.js && cp ./node_modules/htmx.org/dist/ext/sse.js ./internal/web/static/vendor/htmx-sse.js && cp ./node_modules/lucide/dist/umd/lucide.min.js ./internal/web/static/vendor/lucide.min.js && cp ./node_modules/prismjs/prism.js ./internal/web/static/vendor/prism.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.8",
    "codemirror-lang-pkl": "^0.1.0",
    "htmx.org": "^1.9.12",
    "lucide": "^0.468.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "daisyui": "^4.12.24",
    "esbuild": "^0.27.0",
    "tailwindcss": "^3.4.17"
  }
}
